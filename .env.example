# Copy this file to .env and fill in real values.
# .env itself is gitignored and never committed.

# Notion integration token (create at https://notion.so/my-integrations).
# The integration must be shared with each of the 3 study databases.
NOTION_TOKEN=

# Resolved in Phase 2 by running `python -m config.resolve_db_ids`.
# Do NOT hand-edit these — the resolver overwrites them.
NOTION_LEDGER_DB_ID=
NOTION_DOUBTS_DB_ID=
NOTION_REVISION_DB_ID=
NOTION_WORK_ITEMS_DB_ID=
NOTION_GOALS_DB_ID=
NOTION_EXAMS_DB_ID=
NOTION_EXAM_QUESTIONS_DB_ID=
NOTION_DOUBT_ATTEMPTS_DB_ID=
NOTION_TIMETABLE_DB_ID=
NOTION_DAILY_PLAN_DB_ID=

# Telegram bot token (created via @BotFather). Needed at Phase 4.
TELEGRAM_BOT_TOKEN=

# Allowed Telegram user ID (the bot ignores everyone else). Needed at Phase 4.
TELEGRAM_ALLOWED_USER_ID=

# LLM provider config. Needed at Phase 5.
# LLM_PROVIDER = anthropic | openai | kimi
#   Use "openai" for any OpenAI-compatible gateway (eaon, agentrouter, etc.)
#   and set LLM_BASE_URL to that gateway's /v1 endpoint.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=deepseek-v4-pro
# OpenAI-compatible base URL. For eaon: https://api.eaon.dev/v1
LLM_BASE_URL=https://api.eaon.dev/v1
# Optional fallback model(s) tried in order when the primary errors out.
# Comma-separated; each is attempted until one returns valid JSON.
LLM_FALLBACK_MODEL=gemini-3,gemini-3.1-flash-lite,gemini-3.5

# User's IANA timezone (e.g. Asia/Kolkata). Used to auto-clear session context at local midnight.
USER_TIMEZONE=Asia/Kolkata

# Notion-first planning and reminder policy.
PLANNING_REMINDER_TIME=01:00
TIMETABLE_REMINDER_WEEKDAY=6
WEEKLY_REPORT_TIME=20:00
DAILY_CY_BASELINE=240
DAILY_CY_CEILING=300

# Telethon user session (for test_live_telegram.py — live end-to-end test).
# Get these from https://my.telegram.org → API development tools.
# The one-time login is interactive: python3 test_live_telegram.py --login
TELETHON_API_ID=
TELETHON_API_HASH=
